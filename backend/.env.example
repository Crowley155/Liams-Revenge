# === AI model routing ===
# Agno uses DeepInfra for case extraction/reasoning. Embeddings use LiteLLM
# with the configured model and Qdrant vector size below.
PIPELINE_MODEL=deepinfra/nvidia/NVIDIA-Nemotron-Nano-9B-v2
COLLECT_MODEL=deepinfra/nvidia/NVIDIA-Nemotron-Nano-9B-v2
DISAMBIGUATE_MODEL=deepinfra/nvidia/Nemotron-3-Nano-Omni-30B-A3B-Reasoning
SYNTHESIZE_MODEL=deepinfra/nvidia/Nemotron-3-Nano-Omni-30B-A3B-Reasoning
EMBEDDING_MODEL=deepinfra/Qwen/Qwen3-Embedding-8B
QDRANT_VECTOR_SIZE=2048
APP_ENV=production
STRICT_EMBEDDING_PROVIDER_VALIDATION=true

# === Search API (pick one) ===
# SerpAPI ($50/mo, best quality)
SERPAPI_KEY=...
# OR Google Custom Search (free 100/day)
# GOOGLE_CSE_ID=...
# GOOGLE_CSE_API_KEY=...

# === Qdrant (vector store) ===
# Local Docker default - no key needed
QDRANT_URL=http://localhost:6333
# For Qdrant Cloud, add:
# QDRANT_API_KEY=...

# === Langfuse (observability - optional) ===
# LANGFUSE_PUBLIC_KEY=pk-...
# LANGFUSE_SECRET_KEY=sk-...
# LANGFUSE_HOST=https://cloud.langfuse.com

# === Authentication (Clerk) ===
# Use the Clerk production issuer in production. Production domains do not use
# the clerk.accounts.dev development host. Use the production Frontend API URL
# shown by Clerk for the production instance.
# Frontend should request the "usdwatch" JWT template so tokens include email
# and organization claims used for workspace routing.
CLERK_ISSUER=
# Optional override if your Clerk JWT template uses a custom JWKS URL.
CLERK_JWKS_URL=
# Comma-separated emails that get admin entitlements.
USDWATCH_ADMIN_EMAILS=you@example.com
# Comma-separated emails that should own the legacy Crowley/USD 232 case file.
USDWATCH_CASE_OWNER_EMAILS=you@example.com
# Shared secret for locked maintenance endpoints such as KORA response imports.
USDWATCH_MAINTENANCE_TOKEN=change-me-long-random-value
# Local/test-only deterministic token support: Authorization: Bearer dev:user@example.com
ALLOW_DEV_AUTH=false

# Legacy admin seed is retained only for migration continuity; interactive login is Clerk.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me

# === Agno / DeepInfra model routing ===
DEEPINFRA_API_KEY=
DEEPINFRA_EXTRACTION_MODEL=nvidia/NVIDIA-Nemotron-Nano-9B-v2
DEEPINFRA_REASONING_MODEL=nvidia/Nemotron-3-Nano-Omni-30B-A3B-Reasoning
DEEPINFRA_PREMIUM_MODEL=nvidia/NVIDIA-Nemotron-3-Super-120B-A12B
DEEPINFRA_FALLBACK_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
ENABLE_AGENT_OS=false

# === Server ===
HOST=0.0.0.0
PORT=8000
