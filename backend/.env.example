# === LLM Provider (pick one — LiteLLM routes via DSPy) ===
# OpenAI
OPENAI_API_KEY=sk-...
# Anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# Google Gemini
# GEMINI_API_KEY=...

# Default model for the pipeline (LiteLLM format)
# Examples: openai/gpt-4o-mini, anthropic/claude-sonnet-4-20250514, ollama_chat/llama3.2
PIPELINE_MODEL=openai/gpt-4o-mini

# Embedding model (for vector store)
EMBEDDING_MODEL=openai/text-embedding-3-small

# === Search API (pick one) ===
# SerpAPI ($50/mo, best quality)
SERPAPI_KEY=...
# OR Google Custom Search (free 100/day)
# GOOGLE_CSE_ID=...
# GOOGLE_CSE_API_KEY=...

# === Qdrant (vector store) ===
# Local Docker default — no key needed
QDRANT_URL=http://localhost:6333
# For Qdrant Cloud, add:
# QDRANT_API_KEY=...

# === Langfuse (observability — optional) ===
# LANGFUSE_PUBLIC_KEY=pk-...
# LANGFUSE_SECRET_KEY=sk-...
# LANGFUSE_HOST=https://cloud.langfuse.com

# === Authentication (Clerk) ===
# Example: https://your-clerk-domain.clerk.accounts.dev
CLERK_ISSUER=
# Optional override if your Clerk JWT template uses a custom JWKS URL.
CLERK_JWKS_URL=
# Comma-separated emails that get admin entitlements.
USDWATCH_ADMIN_EMAILS=you@example.com
# Comma-separated emails that should own the legacy Crowley/USD 232 case file.
USDWATCH_CASE_OWNER_EMAILS=you@example.com
# Shared secret for locked maintenance endpoints such as KORA response imports.
USDWATCH_MAINTENANCE_TOKEN=change-me-long-random-value
# Local/test-only deterministic token support: Authorization: Bearer dev:user@example.com
ALLOW_DEV_AUTH=false

# Legacy admin seed is retained only for migration continuity; interactive login is Clerk.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me

# === Agno / DeepInfra model routing ===
DEEPINFRA_API_KEY=
DEEPINFRA_EXTRACTION_MODEL=nvidia/NVIDIA-Nemotron-Nano-9B-v2
DEEPINFRA_REASONING_MODEL=nvidia/Nemotron-3-Nano-30B-A3B
DEEPINFRA_PREMIUM_MODEL=nvidia/NVIDIA-Nemotron-3-Super-120B-A12B
DEEPINFRA_FALLBACK_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
ENABLE_AGENT_OS=false

# === Server ===
HOST=0.0.0.0
PORT=8000
