---
import '../index.css';

const {
  title = 'USDWatch',
  description = 'Evidence-backed case evaluation for families.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <div class="min-h-screen flex flex-col bg-background text-text">
      <header class="border-b border-border bg-surface/95">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 h-14 flex items-center justify-between">
          <a href="/" class="text-sm font-bold tracking-wide text-accent uppercase">USDWatch</a>
          <nav class="flex items-center gap-4 text-xs font-semibold text-text-dim">
            <a class="hover:text-text transition-colors" href="/trust">Trust</a>
            <a class="hover:text-text transition-colors" href="/privacy">Privacy</a>
            <a class="hover:text-text transition-colors" href="/login">Sign In</a>
          </nav>
        </div>
      </header>

      <main class="flex-1">
        <slot />
      </main>

      <footer class="border-t border-border py-6">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between text-xs text-text-dim">
          <p>USDWatch - Free case evaluation for families.</p>
          <div class="flex items-center gap-4">
            <a class="hover:text-text transition-colors" href="/trust">Trust Center</a>
            <a class="hover:text-text transition-colors" href="/privacy">Privacy & Disclosures</a>
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>
