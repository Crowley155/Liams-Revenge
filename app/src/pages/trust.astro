---
import PublicPage from '../layouts/PublicPage.astro';

const canonical = 'https://usdwatch.com/trust/';
const description = 'How USDWatch protects family case information, uses AI, and sets honest security expectations.';
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'USDWatch Trust Center',
    url: canonical,
    description,
    isPartOf: {
      '@type': 'WebSite',
      name: 'USDWatch',
      url: 'https://usdwatch.com/',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'Does USDWatch sell family case files?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'No. USDWatch says it does not sell family case files. The service uses providers for authentication, hosting, storage, operations, and AI processing to run the product.',
        },
      },
      {
        '@type': 'Question',
        name: 'Are private family cases public?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'No. New case evaluations live inside the parent workspace. Public demo content is separate from private family workspaces.',
        },
      },
      {
        '@type': 'Question',
        name: 'Does USDWatch claim legal or security certifications?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'USDWatch does not claim to be HIPAA, FERPA, SOC 2, or ISO certified unless and until that is independently true.',
        },
      },
    ],
  },
];
---

<PublicPage
  title="USDWatch Trust Center"
  description={description}
  canonical={canonical}
  schema={schema}
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-10 sm:py-16 space-y-12 animate-fade-up">
    <section class="space-y-5 max-w-3xl">
      <p class="text-xs uppercase tracking-[0.18em] text-accent font-semibold">Trust Center</p>
      <h1 class="text-3xl sm:text-5xl font-bold tracking-tight leading-tight">
        Families should not have to guess what happens to their case file.
      </h1>
      <p class="text-base sm:text-lg leading-relaxed text-text-dim">
        USDWatch handles sensitive school, family, and student information. This page explains the security posture in plain language, including what we do, what we do not do, and where the limits are.
      </p>
      <div class="flex flex-wrap gap-3">
        <a href="/privacy" class="px-4 py-2 rounded-md bg-accent text-background text-sm font-semibold hover:bg-accent-hover transition-colors">
          Privacy & Disclosures
        </a>
        <a href="/ai-disclosure" class="px-4 py-2 rounded-md border border-border text-sm font-semibold text-text hover:bg-surface-alt transition-colors">
          AI Disclosure
        </a>
        <a href="/evaluate" class="px-4 py-2 rounded-md border border-border text-sm font-semibold text-text hover:bg-surface-alt transition-colors">
          Start Evaluation
        </a>
      </div>
    </section>

    <section class="grid gap-4 md:grid-cols-3">
      <article class="bg-surface border border-border rounded-lg p-5 space-y-3">
        <h2 class="font-bold">Private by default</h2>
        <p class="text-sm leading-relaxed text-text-dim">
          New case evaluations live inside your workspace. The public demo case is separate from private family workspaces.
        </p>
      </article>
      <article class="bg-surface border border-border rounded-lg p-5 space-y-3">
        <h2 class="font-bold">No sale of case data</h2>
        <p class="text-sm leading-relaxed text-text-dim">
          We do not sell family case files. We use service providers to run the product, authenticate users, host the app, and generate evaluations.
        </p>
      </article>
      <article class="bg-surface border border-border rounded-lg p-5 space-y-3">
        <h2 class="font-bold">Human-use output</h2>
        <p class="text-sm leading-relaxed text-text-dim">
          Evaluations are informational. They are not legal advice, not a legal filing, and not an automated decision about a child.
        </p>
      </article>
    </section>

    <section class="grid gap-8 lg:grid-cols-[260px_1fr]">
      <div>
        <h2 class="text-xl font-bold">How we protect information</h2>
      </div>
      <div class="space-y-4">
        <article class="bg-surface border border-border rounded-lg p-5 space-y-2">
          <h3 class="font-semibold">Authentication and workspace boundaries</h3>
          <p class="text-sm leading-relaxed text-text-dim">
            Sign-in is handled through Clerk. The backend verifies Clerk session tokens and scopes cases, documents, jobs, evaluations, profiles, entities, and records requests to the active workspace.
          </p>
        </article>
        <article class="bg-surface border border-border rounded-lg p-5 space-y-2">
          <h3 class="font-semibold">Limited access</h3>
          <p class="text-sm leading-relaxed text-text-dim">
            Admin access is intended for operating and supporting the service. Admin/demo content is separated from personal case workspaces. We avoid broad internal access where it is not needed.
          </p>
        </article>
        <article class="bg-surface border border-border rounded-lg p-5 space-y-2">
          <h3 class="font-semibold">Careful AI routing</h3>
          <p class="text-sm leading-relaxed text-text-dim">
            The evaluation workflow uses model providers as processors to read intake details, extract evidence, identify gaps, and synthesize next steps. We route cheaper models to extraction and stronger models to deeper review when a plan allows it.
          </p>
          <a class="text-sm font-semibold text-accent hover:text-accent-hover" href="/ai-disclosure">
            Read the AI disclosure
          </a>
        </article>
        <article class="bg-surface border border-border rounded-lg p-5 space-y-2">
          <h3 class="font-semibold">Operational security</h3>
          <p class="text-sm leading-relaxed text-text-dim">
            Secrets belong in environment variables, not source code. The public frontend only receives public configuration such as the API URL and Clerk publishable key.
          </p>
        </article>
      </div>
    </section>

    <section class="grid gap-8 lg:grid-cols-[260px_1fr]">
      <div>
        <h2 class="text-xl font-bold">What we will not claim</h2>
      </div>
      <div class="space-y-4">
        <div class="bg-surface border border-border rounded-lg p-5">
          <ul class="space-y-3 text-sm leading-relaxed text-text-dim">
            <li>We do not claim the service is HIPAA, FERPA, SOC 2, or ISO certified unless and until that is independently true.</li>
            <li>We do not promise perfect security. No internet service can honestly promise that.</li>
            <li>We do not create an attorney-client relationship or replace a lawyer.</li>
            <li>We do not intentionally publish private family case files.</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="bg-surface border border-border rounded-lg p-5 sm:p-6 space-y-4">
      <h2 class="text-xl font-bold">Security contact</h2>
      <p class="text-sm leading-relaxed text-text-dim">
        If you believe you found a security issue or a privacy problem, email
        <a class="text-accent hover:text-accent-hover" href="mailto:security@usdwatch.com">security@usdwatch.com</a>
        with enough detail for us to reproduce and investigate it. Please do not include another family's private case information in a report.
      </p>
    </section>
  </div>
</PublicPage>
