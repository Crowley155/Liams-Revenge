PUBLIC_API_URL=http://localhost:8000
# Use the Clerk production publishable key in deployed builds.
# Clerk CLI pulls CLERK_PUBLISHABLE_KEY; map that value here for Astro/Vite.
# Production keys start with pk_live_. Development keys start with pk_test_.
PUBLIC_CLERK_PUBLISHABLE_KEY=
PUBLIC_CLERK_JWT_TEMPLATE=usdwatch
PUBLIC_ALLOW_DEV_AUTH=false
